{
  "name": "canipls",
  "displayName": "canipls",
  "description": "See caniuse support info for APIs right in your editor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [],
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:HTML",
    "onLanguage:CSS",
    "onLanguage:JavaScript",
    "onLanguage:TypeScript",
    "onLanguage:JavaScript JSX",
    "onLanguage:TypeScript JSX",
    "onLanguage:vue",
    "onLanguage:Svelte",
    "onLanguage:Astro"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "canipls.restartLanguageServer",
        "title": "canipls: Restart language server"
      }
    ],
    "configuration": {
      "type": "object",
      "properties": {
        "canipls.lsp.path": {
          "scope": "window",
          "type": "string",
          "default": "",
          "description": "Override path to language server exectuable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
